# SENTINEL — environment variables (ROADMAP §2.1 sources + Phase 0 gate notifications)
#
# Copy to .env and fill in real keys. .env is gitignored — NEVER commit secrets.
# Run `pnpm smoke` to verify every source; the Phase 0 gate requires all green.

# --- Alpaca (stocks bars/quotes; free IEX feed) — https://app.alpaca.markets ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# --- IBKR Client Portal Web API (portfolio, read-only in v1) ---
# Requires the local Client Portal Gateway to be running and authenticated.
# https://interactivebrokers.github.io/cpwebapi/
IBKR_GATEWAY_URL=https://localhost:5000

# --- CoinGecko (crypto majors; free demo key) — https://www.coingecko.com/en/api ---
COINGECKO_API_KEY=

# --- Binance (spot REST + WS + futures funding rates) ---
# Public market-data endpoints; no key needed in Phase 0.

# --- DexScreener (Solana memecoins) ---
# Public API; no key needed.

# --- Birdeye (Solana token data; free tier) — https://bds.birdeye.so ---
BIRDEYE_API_KEY=

# --- Helius (Solana RPC) — https://dashboard.helius.dev ---
HELIUS_API_KEY=

# --- RugCheck (token safety) ---
# Public API; no key needed in Phase 0.

# --- Finnhub (news, econ calendar, fundamentals) — https://finnhub.io ---
FINNHUB_API_KEY=

# --- Reddit (mention velocity; script-type app) — https://www.reddit.com/prefs/apps ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent, e.g. "sentinel-smoke/0.1 by <your-reddit-username>"
REDDIT_USER_AGENT=

# --- FRED (macro) — https://fred.stlouisfed.org/docs/api/api_key.html ---
FRED_API_KEY=

# --- ntfy (push alerts; Phase 0 gate) — https://ntfy.sh ---
# Pick a hard-to-guess private topic name; the smoke test posts a test message to it.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# --- Telegram (alerts; Phase 0 gate) — create a bot via @BotFather ---
# The smoke test sends a test message to TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
